# ===============================
# SERVER & DATABASE
# ===============================

PORT=1126
DB_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
NODE_ENV=development


# ===============================
# SUPER ADMIN
# ===============================

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=strong_password_here


# ===============================
# REDIS
# ===============================

REDIS_USERNAME=default
REDIS_PASSWORD=redis_password_here
REDIS_HOST=redis-host.example.com
REDIS_PORT=6379


# ===============================
# SMTP (EMAIL SERVICE)
# ===============================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM=your_email@example.com


# ===============================
# JWT CONFIG
# ===============================

JWT_CREATION_SECRET=creation_secret_here
JWT_CREATION_EXPIRES=2m

JWT_VERIFIED_CREATION_SECRET=verified_creation_secret_here
JWT_VERIFIED_CREATION_EXPIRES=30m

JWT_ACCESS_SECRET=access_secret_here
JWT_ACCESS_EXPIRES=1d

JWT_REFRESH_SECRET=refresh_secret_here
JWT_REFRESH_EXPIRES=30d

JWT_INVITATION_SECRET=invitation_secret_here
JWT_INVITATION_EXPIRES=1d


# ===============================
# BCRYPT
# ===============================

BCRYPT_SALT_ROUND=10


# ===============================
# EXPRESS SESSION
# ===============================

EXPRESS_SESSION_SECRET=express_session_secret_here


# ===============================
# FRONTEND URL
# ===============================

FRONTEND_URL=http://localhost:3000


# ===============================
# CLOUDINARY
# ===============================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ===============================
# SSL COMMERZ (PAYMENT)
# ===============================

SSL_STORE_ID=ssl_store_id_here
SSL_STORE_PASS=ssl_store_password_here

SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v3/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php


# ===============================
# SSL COMMERZ BACKEND URLS
# ===============================

SSL_SUCCESS_BACKEND_URL=http://localhost:1126/api/v1/payment/success
SSL_FAIL_BACKEND_URL=http://localhost:1126/api/v1/payment/fail
SSL_CANCEL_BACKEND_URL=http://localhost:1126/api/v1/payment/cancel


# ===============================
# SSL COMMERZ FRONTEND URLS
# ===============================

SSL_SUCCESS_FRONTEND_URL=http://localhost:3000/payment/success
SSL_FAIL_FRONTEND_URL=http://localhost:3000/payment/fail
SSL_CANCEL_FRONTEND_URL=http://localhost:3000/payment/cancel
