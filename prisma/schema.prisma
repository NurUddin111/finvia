// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String         @id @default(uuid())
  name       String
  email      String         @unique
  password   String
  role       UserRole       @default(USER)
  auths      AuthProvider[]
  isVerified Boolean
  isActive   IsActive       @default(ACTIVE)
  isDeleted  Boolean        @default(false)
  avatar     String?
  phone      String?        @unique
  address    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  businessUsers BusinessUser[]
}

model AuthProvider {
  id         String   @id @default(uuid())
  provider   Provider
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
  BUSINESS_OWNER
  BUSINESS_ADMIN
}

enum Provider {
  google
  credentials
}

enum IsActive {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Business {
  id        String           @id @default(uuid())
  name      String
  category  BusinessCategory
  email     String?          @unique
  phone     String?
  address   String?
  website   String?
  logoUrl   String?
  isDeleted Boolean          @default(false)

  members         BusinessUser[]
  businessClients BusinessClient[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  products  Product[]
}

enum BusinessRole {
  BUSINESS_OWNER
  BUSINESS_ADMIN
}

enum BusinessCategory {
  AGENCY
  ECOMMERCE
  RESTAURANT
  FREELANCER
  SERVICE_PROVIDER
  RETAIL
  SOFTWARE_COMPANY
  EDUCATION
  HEALTHCARE
  REAL_ESTATE
  OTHER
}

model BusinessUser {
  id String @id @default(uuid())

  userId     String
  businessId String

  role BusinessRole @default(BUSINESS_ADMIN)

  status MemberStatus @default(INVITED)

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, businessId])
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

model Client {
  id            String           @id @default(uuid())
  name          String
  email         String
  phone         String?
  address       String?
  totalInvoices Int              @default(0)
  totalSpent    Int              @default(0)
  status        ClientStatus     @default(ACTIVE)
  links         BusinessClient[]
  isDeleted     Boolean          @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model BusinessClient {
  id String @id @default(uuid())

  businessId String
  clientId   String

  business Business @relation(fields: [businessId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, clientId])
}

model Invoice {
  id            String        @id @default(cuid())
  business      Business      @relation(fields: [businessId], references: [id])
  businessId    String
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  createdById   String
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?
  dueDays       Float         @default(0)
  dueDate       DateTime?

  items InvoiceItem[]

  totalItems Int       @default(0)
  subtotal   Float
  tax        Float?
  total      Float
  currency   String    @default("BDT")
  notes      String?
  invPdfUrl  String?
  payments   Payment[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model InvoiceItem {
  id String @id @default(cuid())

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  name         String
  quantity     Float
  pricePerUnit Float
  total        Float

  createdAt DateTime @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  FAILED
  CANCELLED
  OVERDUE
}

model Payment {
  id        String          @id @default(uuid())
  invoice   Invoice         @relation(fields: [invoiceId], references: [id])
  invoiceId String
  method    PaymentMethod
  provider  PaymentGateway?
  tran_id   String
  amount    Float
  currency  String
  status    PaymentStatus   @default(PENDING)
  rcpNumber String?
  rcpPdfUrl String?
  metadata  Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum PaymentGateway {
  SSLCOMMERZ
  STRRIPE
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  CASH
}

model Product {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id])
  name         String
  totalSold    Float         @default(0)
  totalEarning Float         @default(0)
  pendingOrder Float         @default(0)
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  @@unique([businessId, name])
}
