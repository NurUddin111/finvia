// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String         @id @default(uuid())
  name       String
  email      String         @unique
  password   String
  role       UserRole       @default(USER)
  auths      AuthProvider[]
  isVerified Boolean
  isActive   IsActive       @default(ACTIVE)
  isDeleted  Boolean        @default(false)
  avatar     String?
  phone      String?        @unique
  address    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  businessUsers BusinessUser[]
}

model AuthProvider {
  id         String   @id @default(uuid())
  provider   Provider
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
}

enum UserRole {
  ADMIN
  USER
  BUSINESS_OWNER
}

enum Provider {
  google
  credentials
}

enum IsActive {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Business {
  id        String           @id @default(uuid())
  name      String
  category  BusinessCategory
  email     String?          @unique
  phone     String?
  address   String?
  website   String?
  isDeleted Boolean          @default(false)

  members         BusinessUser[]
  businessClients BusinessClient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BusinessRole {
  BUSINESS_OWNER
  BUSINESS_ADMIN
}

enum BusinessCategory {
  AGENCY
  ECOMMERCE
  RESTAURANT
  FREELANCER
  SERVICE_PROVIDER
  RETAIL
  SOFTWARE_COMPANY
  EDUCATION
  HEALTHCARE
  REAL_ESTATE
  OTHER
}

model BusinessUser {
  id String @id @default(uuid())

  userId     String
  businessId String

  role BusinessRole @default(BUSINESS_ADMIN)

  status MemberStatus @default(INVITED)

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, businessId])
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

model Client {
  id      String  @id @default(uuid())
  name    String
  email   String
  phone   String?
  address String?

  links     BusinessClient[]
  isDeleted Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessClient {
  id String @id @default(uuid())

  businessId String
  clientId   String

  business Business @relation(fields: [businessId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, clientId])
}
